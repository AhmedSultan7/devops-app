server {
  listen 8080;
  root /usr/share/nginx/html;
  index index.html;

  location /api/products {
    proxy_pass ${PRODUCT_SERVICE_URL};
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
  }

  location /api/orders {
    proxy_pass ${ORDER_SERVICE_URL};
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
  }

  location / {
    try_files $uri /index.html;
  }
}